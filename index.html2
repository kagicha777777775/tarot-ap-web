  </div>

  <!-- JAVASCRIPT APP LOGIC -->
  <script>
    // Major Arcana with Specific YES/NO Score Propensities (Upright YES %, Reversed YES %)
    const TAROT_CARDS = [
      { id: 0, name: "愚者 (The Fool)", symbol: "🃏", yesScore: 75, reversedYesScore: 35, keyword: "自由・冒険・新たな挑戦", icon: "fa-feather" },
      { id: 1, name: "魔術師 (The Magician)", symbol: "🪄", yesScore: 90, reversedYesScore: 40, keyword: "才能開花・スタート・準備完了", icon: "fa-wand-magic" },
      { id: 2, name: "女教皇 (The High Priestess)", symbol: "📜", yesScore: 45, reversedYesScore: 25, keyword: "静観・直感・慎重な観察", icon: "fa-book-open" },
      { id: 3, name: "女帝 (The Empress)", symbol: "👑", yesScore: 95, reversedYesScore: 50, keyword: "繁栄・愛・実り豊かさ", icon: "fa-crown" },
      { id: 4, name: "皇帝 (The Emperor)", symbol: "🏛️", yesScore: 85, reversedYesScore: 30, keyword: "リーダーシップ・実行・達成", icon: "fa-chess-king" },
      { id: 5, name: "法王 (The Hierophant)", symbol: "⛪", yesScore: 70, reversedYesScore: 40, keyword: "信頼・伝統・アドバイス受容", icon: "fa-hands-praying" },
      { id: 6, name: "恋人たち (The Lovers)", symbol: "💖", yesScore: 95, reversedYesScore: 35, keyword: "調和・好意・最高の選択", icon: "fa-heart" },
      { id: 7, name: "戦車 (The Chariot)", symbol: "🛞", yesScore: 85, reversedYesScore: 30, keyword: "勝利・突破・果敢な進軍", icon: "fa-shield-halved" },
      { id: 8, name: "力 (Strength)", symbol: "🦁", yesScore: 75, reversedYesScore: 35, keyword: "忍耐・コントロール・愛の力", icon: "fa-hand-fist" },
      { id: 9, name: "隠者 (The Hermit)", symbol: "🕯️", keyword: "内省・慎重・焦りは禁物", yesScore: 35, reversedYesScore: 20, icon: "fa-fire-flame-curved" },
      { id: 10, name: "運命の輪 (Wheel of Fortune)", symbol: "🎡", yesScore: 98, reversedYesScore: 25, keyword: "大絶好機・最高の波・転機", icon: "fa-arrows-rotate" },
      { id: 11, name: "正義 (Justice)", symbol: "⚖️", yesScore: 50, reversedYesScore: 30, keyword: "公平な判断・誠実さ・バランス", icon: "fa-scale-balanced" },
      { id: 12, name: "吊るされた男 (The Hanged Man)", symbol: "🦇", yesScore: 20, reversedYesScore: 40, keyword: "試練・視点変更・一休止", icon: "fa-hourglass-half" },
      { id: 13, name: "死神 (Death)", symbol: "🦋", yesScore: 10, reversedYesScore: 45, keyword: "リセット・再スタート・終焉", icon: "fa-skull" },
      { id: 14, name: "節制 (Temperance)", symbol: "🍷", yesScore: 70, reversedYesScore: 40, keyword: "調和・自然体・焦らず調和", icon: "fa-glass-water" },
      { id: 15, name: "悪魔 (The Devil)", symbol: "⛓️", yesScore: 15, reversedYesScore: 50, keyword: "執着・誘惑・見直しが必要", icon: "fa-link" },
      { id: 16, name: "塔 (The Tower)", symbol: "⚡", yesScore: 5, reversedYesScore: 25, keyword: "電撃的変化・壊革・手放し", icon: "fa-bolt" },
      { id: 17, name: "星 (The Star)", symbol: "⭐", yesScore: 90, reversedYesScore: 45, keyword: "希望・インスピレーション・叶う", icon: "fa-star" },
      { id: 18, name: "月 (The Moon)", symbol: "🌙", yesScore: 20, reversedYesScore: 40, keyword: "不透明・不安・時間が解決", icon: "fa-moon" },
      { id: 19, name: "太陽 (The Sun)", symbol: "☀️", yesScore: 100, reversedYesScore: 60, keyword: "大成功・祝福・大吉兆", icon: "fa-sun" },
      { id: 20, name: "審判 (Judgement)", symbol: "📯", yesScore: 90, reversedYesScore: 35, keyword: "覚醒・チャンス再来・復活", icon: "fa-bell" },
      { id: 21, name: "世界 (The World)", symbol: "🌍", yesScore: 100, reversedYesScore: 55, keyword: "完全成就・大団円・最高の答え", icon: "fa-globe" }
    ];

    // State Variables
    let selectedQuestion = "";
    let selectedCard = null;
    let isAudioEnabled = false;
    let audioContext = null;
    let synthUtterance = null;
    let apiKey = localStorage.getItem('tarot_cosmic_key') || '';

    window.onload = function() {
      initStarBackground();
      if(apiKey) {
        document.getElementById('userApiKey').value = apiKey;
      }
    };

    function initStarBackground() {
      const canvas = document.getElementById('stars-canvas');
      const ctx = canvas.getContext('2d');
      let width = canvas.width = window.innerWidth;
      let height = canvas.height = window.innerHeight;

      const stars = Array.from({ length: 120 }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 1.8,
        alpha: Math.random(),
        speed: 0.005 + Math.random() * 0.015
      }));

      function render() {
        ctx.clearRect(0, 0, width, height);
        stars.forEach(s => {
          s.alpha += s.speed;
          if(s.alpha > 1 || s.alpha < 0) s.speed = -s.speed;
          ctx.fillStyle = `rgba(245, 158, 11, ${Math.abs(s.alpha) * 0.7})`;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fill();
        });
        requestAnimationFrame(render);
      }
      render();

      window.onresize = () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      };
    }

    // Audio Chime Logic
    function toggleAudio() {
      isAudioEnabled = !isAudioEnabled;
      const soundIcon = document.getElementById('soundIcon');
      const soundLabel = document.getElementById('soundLabel');

      if(isAudioEnabled) {
        if(!audioContext) {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        soundIcon.className = "fa-solid fa-volume-high text-amber-400 animate-pulse";
        soundLabel.innerText = "Sound ON";
        playCosmicChime(528, 0.4);
      } else {
        soundIcon.className = "fa-solid fa-volume-xmark text-purple-400";
        soundLabel.innerText = "Sound OFF";
      }
    }

    function playCosmicChime(freq = 528, duration = 1.0) {
      if(!isAudioEnabled || !audioContext) return;
      try {
        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, audioContext.currentTime);
        gain.gain.setValueAtTime(0.15, audioContext.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioContext.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioContext.destination);
        osc.start();
        osc.stop(audioContext.currentTime + duration);
      } catch(e){}
    }

    // Presets Click Handler
    function selectPreset(questionText) {
      document.getElementById('userQuestion').value = questionText;
      playCosmicChime(640, 0.3);
      startTarotSession();
    }

    // STEP Navigation Logic
    function startTarotSession() {
      const inputQ = document.getElementById('userQuestion').value.trim();
      selectedQuestion = inputQ || "今の私の問いに対するYES/NOの答え";

      playCosmicChime(432, 1.0);
      document.getElementById('setupSection').classList.add('hidden');
      document.getElementById('shuffleSection').classList.remove('hidden');
      document.getElementById('shuffleSection').classList.add('flex');

      selectedCard = null;
    }

    // Interactive Card Draw Logic
    function handleDeckClick() {
      const deck = document.getElementById('cardDeckStack');
      playCosmicChime(784, 0.5);

      deck.classList.add('rotate-12', 'scale-105');
      setTimeout(() => {
        deck.classList.remove('rotate-12', 'scale-105');
      }, 300);

      if(!selectedCard) {
        const randomCard = TAROT_CARDS[Math.floor(Math.random() * TAROT_CARDS.length)];
        const isReversed = Math.random() < 0.35;
        selectedCard = { ...randomCard, isReversed };

        document.getElementById('shuffleStatusText').innerText = "✨ 運命のカードが選ばれました";
        document.getElementById('shuffleStatusText').className = "text-sm font-sans text-amber-300 font-bold animate-bounce";
        document.getElementById('drawCardsBtn').classList.remove('hidden');
      }
    }

    function drawCards() {
      playCosmicChime(880, 1.2);
      document.getElementById('shuffleSection').classList.add('hidden');
      document.getElementById('shuffleSection').classList.remove('flex');
      document.getElementById('spreadDisplaySection').classList.remove('hidden');

      renderCardGrid();
    }

    function renderCardGrid() {
      const grid = document.getElementById('cardsGrid');
      grid.innerHTML = '';

      const cardElem = document.createElement('div');
      cardElem.className = "w-64 h-96 perspective-1000 my-2";
      cardElem.innerHTML = `
        <div class="card-inner relative w-full h-full rounded-2xl cursor-pointer shadow-2xl transition-transform duration-700" id="cardInner" onclick="flipCard()">
          <div class="card-front absolute inset-0 bg-gradient-to-br from-purple-950 via-cosmic-900 to-purple-900 border-2 border-amber-500/40 rounded-2xl p-4 flex flex-col justify-between items-center gold-border">
            <span class="text-xs uppercase font-sans tracking-widest text-amber-400/80">Decision Oracle Card</span>
            <div class="w-full h-full border border-amber-400/20 rounded-xl flex items-center justify-center relative overflow-hidden my-3">
              <i class="fa-solid fa-scale-balanced text-5xl text-amber-400/40 animate-pulse"></i>
            </div>
            <span class="text-xs font-sans text-purple-300/70">タップしてカードを開眼</span>
          </div>
          
          <div class="card-back absolute inset-0 bg-cosmic-800 border-2 border-amber-400 rounded-2xl p-5 flex flex-col justify-between items-center bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-900 via-cosmic-900 to-black">
            <div class="text-center">
              <span class="text-xs text-amber-400 font-sans tracking-widest uppercase block">Selected Card</span>
              <h4 class="font-serif font-bold text-base text-amber-200 mt-1">${selectedCard.name}</h4>
              <span class="text-xs px-2.5 py-0.5 rounded ${selectedCard.isReversed ? 'bg-rose-950/80 text-rose-300 border border-rose-500/30' : 'bg-emerald-950/80 text-emerald-300 border border-emerald-500/30'} font-sans inline-block mt-1">
                ${selectedCard.isReversed ? '逆位置 (Reversed)' : '正位置 (Upright)'}
              </span>
            </div>
            <div class="my-3 text-center">
              <div class="text-7xl filter drop-shadow-[0_0_20px_rgba(245,158,11,0.6)] ${selectedCard.isReversed ? 'rotate-180' : ''}">
                ${selectedCard.symbol}
              </div>
            </div>
            <div class="text-center w-full bg-cosmic-900/80 p-2.5 rounded-xl border border-purple-800/40">
              <p class="text-xs font-sans text-amber-300/90 font-medium">${selectedCard.keyword}</p>
            </div>
          </div>
        </div>
      `;
      grid.appendChild(cardElem);

      document.getElementById('aiReadingTriggerBox').classList.remove('hidden');
    }

    function flipCard() {
      const cardInner = document.getElementById('cardInner');
      if(!cardInner.classList.contains('card-flipped')) {
        cardInner.classList.add('card-flipped');
        playCosmicChime(950, 0.6);
      }
    }

    async function fetchCosmicReading() {
      flipCard();

      document.getElementById('spreadDisplaySection').classList.add('hidden');
      document.getElementById('readingResultSection').classList.remove('hidden');
      document.getElementById('aiLoading').classList.remove('hidden');
      document.getElementById('readingContent').classList.add('hidden');

      document.getElementById('resultQuestionHeader').innerText = `「${selectedQuestion}」`;

      const systemPrompt = `あなたはタロット神託のYES/NO決断AI「TarotAP YES/NO Engine」です。
ユーザーの質問に対し、引き当てられたカードの象徴とエネルギーから【YES / NO】の明確な判定とアドバイスを行ってください。

必ず以下のJSONフォーマットで回答を返却してください:
{
  "verdict": "【YES】または【NO】または【条件付きYES】",
  "yesProbability": 75, 
  "verdictSummary": "判定理由の要約（80文字程度）",
  "overallMessage": "全体の神託メッセージ（250文字程度で論理的かつ神秘的に）",
  "actionAdvice": "今ユーザーが取るべき具体的な1〜2つのアクション",
  "luckyItems": "運気を高める開運カラー・アイテム"
}`;

      const userPrompt = `質問内容: ${selectedQuestion}
引いたカード: ${selectedCard.name} (${selectedCard.isReversed ? '逆位置' : '正位置'})
カードのキーテーマ: ${selectedCard.keyword}`;

      try {
        const targetApiKey = apiKey || '';
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${targetApiKey}`;

        const payload = {
          contents: [{ parts: [{ text: userPrompt }] }],
          systemInstruction: { parts: [{ text: systemPrompt }] },
          generationConfig: { responseMimeType: "application/json" }
        };

        let resultData = null;

        if(targetApiKey) {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const resJson = await response.json();
          const jsonText = resJson.candidates?.[0]?.content?.parts?.[0]?.text;
          if(jsonText) {
            resultData = JSON.parse(jsonText);
          }
        }

        if(!resultData) {
          resultData = generateFallbackReading(selectedCard, selectedQuestion);
        }

        displayReadingResults(resultData);

      } catch (err) {
        console.warn("TarotAP YES/NO Offline Mode activated.", err);
        const fallback = generateFallbackReading(selectedCard, selectedQuestion);
        displayReadingResults(fallback);
      }
    }

    // Display Interpretation Results & YES/NO Gauges
    function displayReadingResults(data) {
      document.getElementById('aiLoading').classList.add('hidden');
      document.getElementById('readingContent').classList.remove('hidden');

      const verdictBadge = document.getElementById('verdictBadge');
      const yesProb = Math.min(100, Math.max(0, data.yesProbability || 50));
      const noProb = 100 - yesProb;

      // Styling Verdict Badge
      if(data.verdict.includes('YES') && !data.verdict.includes('条件付き')) {
        verdictBadge.innerText = "✨ YES（ポジティブ）";
        verdictBadge.className = "inline-block px-8 py-3 rounded-full font-serif text-2xl md:text-3xl font-extrabold tracking-wider bg-emerald-950/80 text-emerald-300 border-emerald-400 shadow-emerald-900/50 shadow-2xl";
      } else if(data.verdict.includes('NO')) {
        verdictBadge.innerText = "⛔ NO（時期尚早・慎重）";
        verdictBadge.className = "inline-block px-8 py-3 rounded-full font-serif text-2xl md:text-3xl font-extrabold tracking-wider bg-rose-950/80 text-rose-300 border-rose-400 shadow-rose-900/50 shadow-2xl";
      } else {
        verdictBadge.innerText = "⚖️ 条件付きYES（タイミング次第）";
        verdictBadge.className = "inline-block px-8 py-3 rounded-full font-serif text-xl md:text-2xl font-extrabold tracking-wider bg-amber-950/80 text-amber-300 border-amber-400 shadow-amber-900/50 shadow-2xl";
      }

      document.getElementById('yesPercentText').innerText = yesProb;
      document.getElementById('noPercentText').innerText = noProb;
      
      setTimeout(() => {
        document.getElementById('yesProgressBar').style.width = `${yesProb}%`;
      }, 100);

      document.getElementById('verdictSummary').innerText = data.verdictSummary;
      document.getElementById('overallText').innerText = data.overallMessage;
      document.getElementById('actionAdviceText').innerText = data.actionAdvice;
      document.getElementById('luckyItemsText').innerText = data.luckyItems;

      playCosmicChime(600, 1.2);
    }

    // High Precision Local Fallback YES/NO Generator
    function generateFallbackReading(card, question) {
      const calcYesScore = card.isReversed ? card.reversedYesScore : card.yesScore;
      
      let verdictStr = "【YES】";
      if(calcYesScore >= 70) {
        verdictStr = "【YES】";
      } else if(calcYesScore <= 35) {
        verdictStr = "【NO】";
      } else {
        verdictStr = "【条件付きYES】";
      }

      return {
        verdict: verdictStr,
        yesProbability: calcYesScore,
        verdictSummary: `「${card.name}」が示す『${card.keyword}』の波長により、${calcYesScore}%の明確な兆候が現れています。`,
        overallMessage: `ご質問「${question}」に対して展開された『${card.name} (${card.isReversed ? '逆位置' : '正位置'})』は、現在のエネルギーの流れを明確に象徴しています。\n\nカードの象徴する「${card.keyword}」は、焦らず着実に進むことで望む結果へと繋がることを促しています。無理に好転させようとせず、自身の内なる信念に従うことが開運への近道です。`,
        actionAdvice: "選択を確固たるものにするために、まずは今日できる小さな一歩を具体的に行動へ移しましょう。",
        luckyItems: "ラッキーカラー: ルビーゴールド / ラッキーアイテム: 柑橘系アロマ・ノート"
      };
    }

    // TTS Voice Generator
    function speakReading() {
      const summary = document.getElementById('verdictSummary').innerText;
      const text = document.getElementById('overallText').innerText;
      const fullText = `${summary}。 ${text}`;

      if('speechSynthesis' in window) {
        if(window.speechSynthesis.speaking) {
          window.speechSynthesis.cancel();
          document.getElementById('speechBtnText').innerText = "音声で聴く";
          return;
        }

        synthUtterance = new SpeechSynthesisUtterance(fullText);
        synthUtterance.lang = 'ja-JP';
        synthUtterance.rate = 0.95;

        synthUtterance.onend = () => {
          document.getElementById('speechBtnText').innerText = "音声で聴く";
        };

        window.speechSynthesis.speak(synthUtterance);
        document.getElementById('speechBtnText').innerText = "停止する";
      } else {
        alert("お使いのブラウザは音声読み上げに対応していません。");
      }
    }

    // Copy Result to Clipboard
    function copyReadingResult() {
      const verdict = document.getElementById('verdictBadge').innerText;
      const yesP = document.getElementById('yesPercentText').innerText;
      const text = `【TarotAP YES/NO タロット鑑定結果】\n質問: 「${selectedQuestion}」\n判定: ${verdict} (YES確率 ${yesP}%)\n\n■ 概要\n${document.getElementById('verdictSummary').innerText}\n\n■ 詳細アドバイス\n${document.getElementById('actionAdviceText').innerText}\n\n#TarotAP #タロット占い #YESNOタロット`;
      
      const textarea = document.createElement('textarea');
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);

      playCosmicChime(1000, 0.3);
      alert("鑑定結果をクリップボードにコピーしました！");
    }

    // Modal Control Functions
    function openApiModal() {
      document.getElementById('apiModal').classList.remove('hidden');
    }
    function closeApiModal() {
      document.getElementById('apiModal').classList.add('hidden');
    }
    function saveApiKey() {
      const val = document.getElementById('userApiKey').value.trim();
      apiKey = val;
      localStorage.setItem('tarot_cosmic_key', val);
      closeApiModal();
      playCosmicChime(700, 0.4);
      alert("TarotAP Engine APIキーを保存しました。");
    }

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    function resetApp() {
      location.reload();
    }
  </script>
</body>
</html>

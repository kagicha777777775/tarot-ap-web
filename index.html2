<!DOCTYPE html>
<html lang="ja" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TarotAP YES/NO - 神秘のYES/NOタロット決断鑑定</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            cosmic: {
              900: '#0B0A1A',
              800: '#14122B',
              700: '#231E47',
              600: '#382F6B',
              accent: '#C084FC',
              gold: '#F59E0B',
              goldGlow: '#FDE047',
              yes: '#10B981',
              no: '#EF4444'
            }
          },
          fontFamily: {
            serif: ['Cinzel', 'Shippori Mincho', 'serif'],
            sans: ['Inter', 'sans-serif']
          },
          animation: {
            'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'float': 'float 6s ease-in-out infinite',
            'glow': 'glow 2s ease-in-out infinite alternate',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
              '50%': { transform: 'translateY(-10px) rotate(1deg)' },
            },
            glow: {
              '0%': { boxShadow: '0 0 15px rgba(192, 132, 252, 0.4)' },
              '100%': { boxShadow: '0 0 30px rgba(245, 158, 11, 0.8)' }
            }
          }
        }
      }
    }
  </script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Shippori+Mincho:wght@400;600;800&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    body {
      background-color: #0B0A1A;
      color: #E2E8F0;
      font-family: 'Shippori Mincho', 'Inter', sans-serif;
      overflow-x: hidden;
    }
    
    #stars-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      pointer-events: none;
    }

    .perspective-1000 {
      perspective: 1000px;
    }
    .card-inner {
      transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      transform-style: preserve-3d;
    }
    .card-flipped {
      transform: rotateY(180deg);
    }
    .card-front, .card-back {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .card-back {
      transform: rotateY(180deg);
    }

    .gold-border {
      border: 1px solid rgba(245, 158, 11, 0.3);
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.1) inset;
    }

    .gold-gradient-text {
      background: linear-gradient(135deg, #FFF5C0 0%, #F59E0B 50%, #D97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .purple-gradient-text {
      background: linear-gradient(135deg, #E9D5FF 0%, #C084FC 50%, #A855F7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0B0A1A;
    }
    ::-webkit-scrollbar-thumb {
      background: #382F6B;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #C084FC;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative selection:bg-cosmic-accent selection:text-black">
  <canvas id="stars-canvas"></canvas>

  <header class="border-b border-purple-900/40 bg-cosmic-900/80 backdrop-blur-md sticky top-0 z-40 px-4 lg:px-8 py-3.5 transition-all">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer" onclick="resetApp()">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-900 via-cosmic-600 to-amber-500 p-[1px] flex items-center justify-center shadow-lg shadow-purple-900/30">
          <div class="w-full h-full bg-cosmic-900 rounded-full flex items-center justify-center">
            <i class="fa-solid fa-scale-balanced text-amber-400 text-lg"></i>
          </div>
        </div>
        <div>
          <h1 class="font-serif font-bold text-xl tracking-wider gold-gradient-text">TarotAP <span class="text-xs px-2 py-0.5 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 font-sans font-normal">YES / NO</span></h1>
          <p class="text-[10px] text-purple-300/60 font-sans tracking-widest uppercase">Cosmic Decision Oracle Engine v3.2</p>
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <button id="soundToggleBtn" onclick="toggleAudio()" class="p-2.5 rounded-xl bg-cosmic-800/80 hover:bg-cosmic-700 text-purple-200 hover:text-amber-300 border border-purple-800/50 transition-all flex items-center space-x-2 text-xs" title="効果音 / BGM">
          <i id="soundIcon" class="fa-solid fa-volume-xmark text-purple-400"></i>
          <span class="hidden sm:inline font-sans" id="soundLabel">Sound OFF</span>
        </button>

        <button onclick="openApiModal()" class="p-2.5 rounded-xl bg-gradient-to-r from-purple-900/50 to-cosmic-700/50 hover:from-purple-800 hover:to-cosmic-600 text-amber-300 border border-amber-500/30 transition-all flex items-center space-x-2 text-xs shadow-md">
          <i class="fa-solid fa-key"></i>
          <span class="hidden md:inline font-sans">鑑定APIキー設定</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Top Ad Banner -->
  <div class="max-w-7xl mx-auto w-full px-4 pt-4">
    <div class="bg-cosmic-800/30 border border-purple-900/30 rounded-2xl p-2 text-center text-xs text-purple-400/60 flex items-center justify-center min-h-[60px]">
      <i class="fa-solid fa-rectangle-ad text-amber-500/40 text-lg mr-2"></i>
      <span>スポンサーリンク (Google AdSense 枠)</span>
    </div>
  </div>

  <main class="max-w-5xl mx-auto w-full px-4 py-6 flex-grow flex flex-col justify-center items-center">
    
    <!-- STEP 1: Question Setup Panel -->
    <section id="setupSection" class="w-full space-y-8 animate-fade-in">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-purple-900/30 border border-purple-500/20 text-purple-300 text-xs tracking-widest font-sans">
          <i class="fa-solid fa-sparkles text-amber-400"></i>
          <span>一瞬で迷いを断ち切るタロット神託</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold gold-gradient-text tracking-wide leading-tight">
          YESか、NOか。<br class="hidden sm:inline">聖なるカードが示す真実の答え
        </h2>
        <p class="text-sm text-purple-200/70 font-sans leading-relaxed">
          あなたの胸にある「YESかNOか知りたい悩み」を直接入力するか、<br class="hidden sm:inline">下のアシスト質問をタップしてください。
        </p>
      </div>

      <!-- Quick Preset Questions Section (10 Topics) -->
      <div class="bg-cosmic-800/40 backdrop-blur-md border border-purple-800/40 rounded-3xl p-6 md:p-8 space-y-6 shadow-2xl relative gold-border">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-sans font-medium uppercase tracking-widest text-amber-400">
              <i class="fa-solid fa-bolt mr-1.5"></i> ワンタップで占う（よくある悩み 10選）
            </label>
            <span class="text-[11px] text-purple-400/80 font-sans">タップすると即座に開始します</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 font-sans text-xs">
            <button onclick="selectPreset('あの人は今、私のことを好きですか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">💖</span>
              <span class="truncate">あの人は今、私のことを好きですか？</span>
            </button>
            <button onclick="selectPreset('今のパートナーと将来、結婚できますか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">💍</span>
              <span class="truncate">今のパートナーと将来、結婚できますか？</span>
            </button>
            <button onclick="selectPreset('連絡や返信は今日中に来ますか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">💬</span>
              <span class="truncate">連絡や返信は今日中に来ますか？</span>
            </button>
            <button onclick="selectPreset('転職や新しい仕事に挑戦すべきですか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">💼</span>
              <span class="truncate">転職や新しい仕事に挑戦すべきですか？</span>
            </button>
            <button onclick="selectPreset('今のプロジェクトやビジネスは成功しますか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">📈</span>
              <span class="truncate">今のプロジェクトやビジネスは成功しますか？</span>
            </button>
            <button onclick="selectPreset('近いうちに金運や収入はアップしますか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">💰</span>
              <span class="truncate">近いうちに金運や収入はアップしますか？</span>
            </button>
            <button onclick="selectPreset('あの人と復縁・関係修復できますか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">🤝</span>
              <span class="truncate">あの人と復縁・関係修復できますか？</span>
            </button>
            <button onclick="selectPreset('近いうちに引越しや環境を変えても大丈夫？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">✈️</span>
              <span class="truncate">近いうちに引越しや環境を変えても大丈夫？</span>
            </button>
            <button onclick="selectPreset('今日、思い切って行動を起こすべきですか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">🔮</span>
              <span class="truncate">今日、思い切って行動を起こすべきですか？</span>
            </button>
            <button onclick="selectPreset('自分の直感や予感は当たっていますか？')" class="preset-btn p-3 rounded-xl border border-purple-700/40 bg-cosmic-900/70 hover:border-amber-400/80 hover:bg-purple-900/40 transition-all text-left text-purple-200 flex items-center space-x-2 group">
              <span class="text-base group-hover:scale-110 transition-transform">✨</span>
              <span class="truncate">自分の直感や予感は当たっていますか？</span>
            </button>
          </div>
        </div>

        <!-- Custom Manual Input Area -->
        <div class="space-y-2 pt-2 border-t border-purple-800/40">
          <label class="block text-xs font-sans font-medium uppercase tracking-widest text-amber-400">
            <i class="fa-solid fa-pen-nib mr-1.5"></i> 自分で質問を文章で入力する
          </label>
          <div class="relative">
            <textarea id="userQuestion" rows="3" placeholder="「YES」または「NO」で答えられる質問を入力してください（例：今日告白しても成功しますか？など）" class="w-full bg-cosmic-900/80 border border-purple-800/60 rounded-2xl p-4 text-sm text-purple-100 placeholder-purple-400/40 focus:outline-none focus:border-amber-400/80 focus:ring-1 focus:ring-amber-400/50 transition-all font-sans"></textarea>
          </div>
        </div>

        <div class="pt-2">
          <button id="startShuffleBtn" onclick="startTarotSession()" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-purple-600 to-cosmic-600 text-white font-serif font-bold text-base md:text-lg shadow-xl shadow-purple-900/40 hover:shadow-amber-500/20 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center space-x-3 border border-amber-300/30">
            <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
            <span>運命のタロットでYES/NOを占う</span>
          </button>
        </div>
      </div>
    </section>

    <!-- STEP 2: Card Shuffle & Draw Screen -->
    <section id="shuffleSection" class="w-full hidden space-y-8 flex-col items-center justify-center py-6 animate-fade-in">
      <div class="text-center space-y-2">
        <h3 id="shuffleTitle" class="text-2xl font-serif font-bold gold-gradient-text">意識をカードに集中させてください</h3>
        <p class="text-xs text-purple-300/70 font-sans" id="shuffleSubtitle">質問に対する【YES/NO】の波動を導き出します</p>
      </div>

      <div id="deckContainer" onclick="handleDeckClick()" class="relative w-48 h-72 cursor-pointer group my-4 perspective-1000">
        <div id="cardDeckStack" class="relative w-full h-full transition-all duration-500">
          <div class="absolute inset-0 bg-cosmic-800 border-2 border-amber-500/40 rounded-2xl shadow-2xl flex items-center justify-center overflow-hidden transform translate-x-0 translate-y-0 group-hover:shadow-amber-500/30">
            <div class="w-full h-full p-3 bg-gradient-to-br from-purple-950 via-cosmic-900 to-purple-900 flex items-center justify-center">
              <div class="w-full h-full border border-amber-400/30 rounded-xl flex items-center justify-center relative overflow-hidden">
                <i class="fa-solid fa-scale-balanced text-5xl text-amber-400/30 animate-pulse"></i>
                <div class="absolute inset-0 bg-[radial-gradient(circle,_transparent_30%,_#0B0A1A_100%)]"></div>
              </div>
            </div>
          </div>
          <div class="absolute inset-0 bg-cosmic-800 border-2 border-purple-500/30 rounded-2xl shadow-xl transform -translate-x-1.5 -translate-y-1.5 pointer-events-none"></div>
          <div class="absolute inset-0 bg-cosmic-800 border-2 border-purple-500/20 rounded-2xl shadow-md transform -translate-x-3 -translate-y-3 pointer-events-none"></div>
        </div>
      </div>

      <div class="flex flex-col items-center space-y-3">
        <p id="shuffleStatusText" class="text-sm font-sans text-amber-300/90 font-medium animate-pulse">
          <i class="fa-solid fa-hand-pointer mr-1.5"></i> デッキをタップして聖なるカードを1枚オープン
        </p>
        <button id="drawCardsBtn" onclick="drawCards()" class="hidden py-3 px-8 rounded-full bg-gradient-to-r from-amber-500 to-purple-600 text-white font-sans font-bold text-sm shadow-lg border border-amber-300/40 hover:scale-105 transition-all">
          判定カードを開眼する
        </button>
      </div>
    </section>

    <!-- STEP 3: Reveal Single Card Area -->
    <section id="spreadDisplaySection" class="w-full hidden space-y-8 animate-fade-in">
      <div class="text-center space-y-2">
        <span class="text-xs font-sans uppercase tracking-widest text-amber-400">Oracle Decision Card Revealed</span>
        <h3 class="text-2xl md:text-3xl font-serif font-bold gold-gradient-text">運命の導き手</h3>
      </div>

      <div id="cardsGrid" class="flex justify-center max-w-4xl mx-auto">
        <!-- Dynamic Card Inserted Here -->
      </div>

      <div id="aiReadingTriggerBox" class="text-center pt-4 hidden">
        <button id="generateReadingBtn" onclick="fetchCosmicReading()" class="py-4 px-10 rounded-2xl bg-gradient-to-r from-amber-500 via-purple-600 to-cosmic-600 text-white font-serif font-bold text-base md:text-lg shadow-2xl hover:scale-105 active:scale-95 transition-all border border-amber-300/40">
          <i class="fa-solid fa-burst mr-2 text-amber-300"></i>
          <span>YES/NO の結論と詳細解釈を見る</span>
        </button>
      </div>
    </section>

    <!-- STEP 4: YES/NO Reading Result Screen -->
    <section id="readingResultSection" class="w-full hidden space-y-8 animate-fade-in">
      
      <div class="bg-cosmic-800/50 backdrop-blur-xl border border-purple-800/50 rounded-3xl p-6 md:p-10 shadow-2xl space-y-8 relative overflow-hidden gold-border">
        
        <!-- Header Controls -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-purple-800/40 pb-6 gap-4">
          <div>
            <div class="flex items-center space-x-2 text-xs text-amber-400 font-sans mb-1">
              <i class="fa-solid fa-microchip"></i>
              <span>TarotAP Cosmic Decision Engine 鑑定書</span>
            </div>
            <h3 id="resultQuestionHeader" class="text-lg md:text-xl font-serif font-bold purple-gradient-text">
              「質問内容」の鑑定結果
            </h3>
          </div>
          
          <div class="flex items-center space-x-2 w-full sm:w-auto">
            <button onclick="speakReading()" id="speechBtn" class="flex-1 sm:flex-none py-2 px-3.5 rounded-xl bg-purple-900/40 hover:bg-purple-800/60 border border-purple-700/50 text-xs text-purple-200 transition-all flex items-center justify-center space-x-1.5">
              <i class="fa-solid fa-volume-high text-amber-400"></i>
              <span id="speechBtnText">音声で聴く</span>
            </button>
            <button onclick="copyReadingResult()" class="flex-1 sm:flex-none py-2 px-3.5 rounded-xl bg-purple-900/40 hover:bg-purple-800/60 border border-purple-700/50 text-xs text-purple-200 transition-all flex items-center justify-center space-x-1.5">
              <i class="fa-regular fa-copy text-amber-400"></i>
              <span>結果をコピー</span>
            </button>
          </div>
        </div>

        <!-- AI Loading Spinner -->
        <div id="aiLoading" class="py-16 text-center space-y-4">
          <div class="inline-block relative w-16 h-16">
            <div class="w-16 h-16 rounded-full border-4 border-purple-900 border-t-amber-400 animate-spin"></div>
            <i class="fa-solid fa-scale-balanced absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-amber-400 text-sm"></i>
          </div>
          <p class="text-sm font-sans text-purple-300/80 animate-pulse">
            TarotAP Engineが【YES/NO】の結論とアドバイスを分析しています...
          </p>
        </div>

        <!-- Result Display Container -->
        <div id="readingContent" class="hidden space-y-8 font-sans text-sm md:text-base leading-relaxed">
          
          <!-- Core YES/NO Badge & Probability Gauge -->
          <div class="bg-gradient-to-br from-purple-950/80 via-cosmic-900 to-purple-900/80 p-6 md:p-8 rounded-3xl border border-amber-500/30 text-center space-y-6 shadow-xl relative overflow-hidden">
            <div class="space-y-2">
              <span class="text-xs uppercase font-sans tracking-widest text-amber-400">Decision Conclusion</span>
              <div id="verdictBadge" class="inline-block px-8 py-3 rounded-full font-serif text-2xl md:text-3xl font-extrabold tracking-wider border shadow-2xl">
                判定結果
              </div>
            </div>

            <!-- Probability Bar -->
            <div class="max-w-md mx-auto space-y-2">
              <div class="flex justify-between text-xs font-bold font-sans">
                <span class="text-emerald-400"><i class="fa-solid fa-circle-check"></i> YES傾向: <span id="yesPercentText">0</span>%</span>
                <span class="text-rose-400">NO傾向: <span id="noPercentText">0</span>% <i class="fa-solid fa-circle-xmark"></i></span>
              </div>
              <div class="w-full bg-cosmic-950 h-4 rounded-full overflow-hidden p-0.5 border border-purple-800">
                <div id="yesProgressBar" class="h-full bg-gradient-to-r from-amber-400 via-emerald-400 to-emerald-500 rounded-full transition-all duration-1000" style="width: 0%"></div>
              </div>
            </div>

            <p id="verdictSummary" class="text-sm font-medium text-purple-200/90 leading-relaxed max-w-xl mx-auto"></p>
          </div>

          <!-- Overall Detailed Interpretation Message -->
          <div class="space-y-3 bg-cosmic-900/60 p-5 md:p-6 rounded-2xl border border-purple-800/30">
            <h4 class="font-serif font-bold text-amber-300 text-lg flex items-center">
              <i class="fa-solid fa-scroll mr-2 text-amber-400 text-sm"></i> 神託の詳細解説＆カードの意味
            </h4>
            <p id="overallText" class="text-purple-100/90 whitespace-pre-line leading-relaxed"></p>
          </div>

          <!-- Actionable Steps & Key Advice -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="bg-purple-950/40 p-5 rounded-2xl border border-purple-800/40 space-y-2">
              <h5 class="font-bold text-amber-300 text-sm flex items-center">
                <i class="fa-solid fa-compass mr-2"></i> 願望成就・選択のためのアドバイス
              </h5>
              <p id="actionAdviceText" class="text-xs md:text-sm text-purple-200/80"></p>
            </div>
